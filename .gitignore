__pycache__/
*.pyc
.ipynb_checkpoints/

# Only dataset/{raw,pairs,processed}/demo/ (the small procedurally generated
# demo set, see dataset/make_sample_dataset.py) is tracked in git. Full-scale
# generated datasets (dataset/make_sample_dataset.py --count_per_category 500+,
# or preprocessing/generate_pairs.py output, or a real ABC/Objaverse/Thingi10K
# drop-in) are regenerable/large and stay untracked.
dataset/raw/*
!dataset/raw/demo/
!dataset/raw/demo/**
!dataset/raw/.gitkeep

dataset/pairs/*
!dataset/pairs/demo/
!dataset/pairs/demo/**
!dataset/pairs/.gitkeep

dataset/processed/*
!dataset/processed/demo/
!dataset/processed/demo/**
!dataset/processed/.gitkeep

checkpoints/

*.egg-info/
.venv/
venv/
.DS_Store
